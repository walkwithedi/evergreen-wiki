[Desktop Entry]
Type=Application
Name=Knowledge base setup
Name[zh_CN]=知识库设置
Comment=Install the evergreen-wiki skills, set up a library, back up, move or uninstall
Comment[zh_CN]=安装知识库技能、建库，以及备份、回滚、移动、卸载
Exec=sh -c 'cd "$(dirname "$1")" && exec python3 desktop_setup.py' evergreen-wiki-setup %k
Terminal=true
Icon=system-software-install
Categories=Utility;
